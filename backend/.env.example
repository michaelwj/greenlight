# Greenlight configuration.
# ./setup.sh fills this in for you; everything can also be edited by hand.
# Apply changes with: docker compose up -d

# ---------- Core ----------
APP_ENV=prod
# Long random string; setup.sh generates one.
APP_SECRET_KEY=replace-me
# Kids type this once on their device to use the kid portal.
HOUSEHOLD_CODE=000000
# Defines "today" for daily request limits.
HOUSEHOLD_TIMEZONE=America/Chicago
# The password portion must match POSTGRES_PASSWORD in the repo-root .env.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/greenlight
REDIS_URL=redis://redis:6379/0

# ---------- AI screening ----------
# AI_PROVIDER: api (OpenAI-compatible endpoint), anthropic (native Messages
# API), command (pipe the prompt to a shell command), or leave keys empty to
# disable AI — then every request goes to parent review, which is safe.
AI_PROVIDER=api
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_BASE_URL=https://api.openai.com/v1
AI_COMMAND=
AI_COMMAND_TIMEOUT_SECONDS=180
# Below this confidence, nothing auto-approves.
AI_CONFIDENCE_THRESHOLD=0.75

# ---------- Screening policy ----------
# Videos longer than this are never auto-approved (seconds).
YOUTUBE_MAX_DURATION_SECONDS=1800
# Comma-separated channel names that seed the trust/block lists.
TRUSTED_CHANNELS=Khan Academy,MIT OpenCourseWare,Crash Course
BLOCKED_CHANNELS=
# Entertainment auto-approval (educational content auto-approves when clean).
AUTO_APPROVE_ENTERTAINMENT=false
REQUIRE_TRANSCRIPT_FOR_AUTO_APPROVE=false
# Weekly entertainment minutes per kid (parents can change per kid in the app).
DEFAULT_ENTERTAINMENT_WEEKLY_MINUTES=120
# Topics that never auto-approve — flagged videos always go to a parent, even
# from trusted channels. Plain-language, comma-separated; edit to fit your
# family's rules. The AI screener reads this list verbatim.
SENSITIVE_TOPICS=health or medical advice, human anatomy, romantic relationships or dating, sexual content or sexual innuendo, violence or graphic content, domestic abuse, law breaking or crime glorification, legal advice, misogynistic influencer content, hate speech or discrimination
# Per-kid request cap per local day (0 disables; adjustable per kid in the app).
DAILY_REQUEST_LIMIT=10
# Videos shorter than this many minutes never auto-approve (0 disables).
SHORT_VIDEO_REVIEW_MINUTES=5
TRANSCRIPT_MAX_CHARS=12000

# ---------- Downloads ----------
# Transient failures (429/403/network) retry with progressive delays, and a
# minimum gap is kept between YouTube downloads to stay polite.
DOWNLOAD_MAX_RETRIES=3
DOWNLOAD_RETRY_DELAYS=30,60,90
YOUTUBE_MIN_GAP_SECONDS=30
SPONSORBLOCK_ENABLED=true

# ---------- Plex ----------
# Container path for downloads; the host side is MEDIA_ROOT in the root .env.
PLEX_MEDIA_ROOT=/media/greenlight
# Your Plex server, e.g. http://192.168.1.20:32400 — see docs/install.md for
# how to find the token and library section id. Leave empty to skip Plex
# integration (files still download to the media folder).
PLEX_URL=
PLEX_TOKEN=
PLEX_LIBRARY_SECTION_ID=
# Each video is labeled with the requesting kid's name; this is the fallback
# label if the kid record is missing.
PLEX_LABEL=greenlight

# ---------- Subscriptions & housekeeping ----------
# Trusted channels can be subscribed to; new uploads are screened automatically.
SUBSCRIPTION_POLL_HOURS=6
SUBSCRIPTION_MAX_NEW_PER_POLL=3
# Entertainment downloads older than this are cleaned up (educational stays).
ENTERTAINMENT_RETENTION_DAYS=30
# Weekly digest: 0=Monday .. 6=Sunday, hour in UTC.
DIGEST_WEEKDAY=6
DIGEST_HOUR_UTC=18

# ---------- Web push (parent notifications) ----------
# setup.sh generates these; or: python scripts/admin_cli.py generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
